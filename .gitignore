# Personal, machine-local Claude Code settings — never commit.
# This repo is served publicly at its root by GitHub Pages.
.claude/settings.local.json

# Multi-root workspace pointing at ../yootri-rnd — only valid on this machine.
yootri.code-workspace

# Editor/OS noise
.DS_Store

# Private working notes and drafts. Anything committed here is served publicly,
# so these stay local. `.gitignore` does not untrack a file that is already
# committed — use `git rm --cached` if one ever slips in.
yootri-viability-and-legal.md
yootri-gumroad-readiness.md
GUMROAD.md
RELEASE-CHECKLIST.md

# Browser-automation debris: console logs that capture real sign-in flows.
.playwright-mcp/

# The Garmin bridge's local environment. Its session and pairing token live in
# ~/.config/yootri, never here — these two names are listed anyway, so a copy
# made by hand into the tree can never be committed.
tools/garmin-bridge/.venv/
__pycache__/
.pytest_cache/
garmin-tokens.json
garmin-bridge-token
